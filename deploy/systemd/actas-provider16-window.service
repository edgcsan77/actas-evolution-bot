[Unit]
Description=ACTAS PROVIDER16 operating window reconciler
After=network.target redis-server.service postgresql.service
Wants=redis-server.service postgresql.service

[Service]
Type=oneshot
User=root
WorkingDirectory=/root/actas-evolution-bot
Environment="PYTHONPATH=/root/actas-evolution-bot"
EnvironmentFile=/root/actas-evolution-bot/.env
EnvironmentFile=-/root/actas-evolution-bot/.sidea.env
TimeoutStartSec=700
ExecStart=/root/actas-evolution-bot/venv/bin/python /root/actas-evolution-bot/scripts/provider16_window.py
